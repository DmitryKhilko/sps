{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontmatter статьи базы знаний",
  "description": "Проверяет структуру и типы. Допустимые значения enum-полей проверяются по taxonomy.yml (единый источник истины).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id", "title", "summary", "doc_type", "status", "language",
    "department", "owner", "sensitivity_level", "allowed_groups", "last_updated"
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    }
  },
  "properties": {
    "document_id": { "$ref": "#/$defs/uuid" },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 300 },
    "doc_type": { "$ref": "#/$defs/slug" },
    "topic": { "$ref": "#/$defs/slug" },
    "department": { "$ref": "#/$defs/slug" },
    "product": { "$ref": "#/$defs/slug" },
    "product_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "audience": { "$ref": "#/$defs/slug" },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "region": { "$ref": "#/$defs/slug" },
    "status": { "$ref": "#/$defs/slug" },
    "doc_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?(-[a-z0-9.]+)?$"
    },
    "date_published": { "$ref": "#/$defs/date" },
    "last_updated": { "$ref": "#/$defs/date" },
    "review_date": { "$ref": "#/$defs/date" },
    "valid_until": { "$ref": "#/$defs/date" },
    "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
    "supersedes": { "$ref": "#/$defs/uuid" },
    "replaced_by": { "$ref": "#/$defs/uuid" },
    "sensitivity_level": { "$ref": "#/$defs/slug" },
    "allowed_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "aliases": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "questions": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5, "maxLength": 200 }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    }
  }
}
